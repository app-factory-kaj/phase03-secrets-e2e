// phase03-secrets-e2e — single screen: live date/time display

screen HelloClock "Any visitor sees the current date and time, updating live"
  navbar "phase03-secrets-e2e"
  heading "Hello, world"
  text "The current date and time, updating every second"
  card "Tuesday, July 29, 2026 | 14:32:07 | Local browser time"
  text "No sign-in, no backend, no external calls — just your browser's clock"
